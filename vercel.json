{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "my-css-battle-sol.vercel.app"
        }
      ],
      "destination": "https://www.cssbattledaily.site/:path*",
      "permanent": true
    }
  ]
}
